# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bommagic

# Redis for job queue
REDIS_URL=redis://localhost:6379/0

# Flask
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# Session
SESSION_SECRET=your-session-secret-here

# Object Storage
STORAGE_BUCKET=bommagic-documents
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# Authentication (Replit)
REPL_ID=your-repl-id
ISSUER_URL=https://replit.com/oidc

# OCR Settings
OCR_TIMEOUT=300
OCR_DPI=300
OCR_LANGUAGE=eng

# Processing Settings
MAX_FILE_SIZE=104857600
CONFIDENCE_THRESHOLD=0.92
AUTO_EXPORT_THRESHOLD=0.92

# Monitoring (Optional)
SENTRY_DSN=
LOG_LEVEL=INFO

# Worker Settings
WORKER_CONCURRENCY=2
JOB_TIMEOUT=600

# API Settings
API_BASE_URL=http://localhost:5000
CORS_ORIGINS=*